# Copy this file to ".env" (same folder) and paste in your real API key.
# Never commit your real .env file to git or share it publicly.
# The application loads this file automatically — no manual terminal
# commands needed.

# Get a Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy_your_real_key_here

# Optional: which Gemini model to call. Defaults to "gemini-3.6-flash" if
# not set. Override this if Google retires/renames the default model
# again — a one-line env change here, no code deploy needed.
# GEMINI_MODEL_NAME=gemini-3.6-flash

# Required: protects every /admin/* endpoint (restaurant, menu, opening
# hours). Requests must send this exact value in the "X-Admin-API-Key"
# header. Generate a long random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change_me_to_a_long_random_secret

# Optional: while rotating ADMIN_API_KEY, set this to the OLD key value
# and both the old and new keys are accepted. Remove this line once every
# admin client has switched to the new ADMIN_API_KEY to fully revoke the
# old one. See README.md ("Rotating the admin key") for the full steps.
# ADMIN_API_KEY_PREVIOUS=the_old_key_value_being_retired

# Optional: only needed if you want to point at a different database.
# By default the app uses backend/restaurant.db automatically (SQLite,
# zero setup). To use PostgreSQL instead (see README.md, "PostgreSQL"),
# point this at it — e.g. for the docker-compose Postgres service:
#   DATABASE_URL=postgresql+psycopg2://restaurant_ai_agent:restaurant_ai_agent@localhost:5432/restaurant_ai_agent
# Managed providers often require SSL — check if you need to append
# ?sslmode=require to their connection string.
# DATABASE_URL=sqlite:///./restaurant.db

# Whichever database you use, run `alembic upgrade head` (from backend/)
# once before starting the app, and again after pulling any change that
# adds a migration — see README.md ("Database migrations").

# Optional: comma-separated list of browser origins allowed to call this
# API (CORS). If not set, defaults to common localhost dev origins plus
# "null" (the Origin a browser sends for a page opened directly as a
# local file, e.g. double-clicking frontend/index.html) — see README.
# Before deploying, set this to your real frontend domain(s) instead,
# e.g.:
#   ALLOWED_ORIGINS=https://www.example.com,https://example.com
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: trusted reverse-proxy IP(s) for request.client.host (used for
# rate limiting and failed-admin-auth logging — see app/rate_limit.py and
# app/auth.py). uvicorn's ProxyHeadersMiddleware is already enabled by
# default (see the Dockerfile CMD), but it only rewrites the client
# address from X-Forwarded-For when the actual connecting peer's address
# is in this list — it defaults to "127.0.0.1" (a same-host proxy only),
# which is NOT Railway's edge. Behind a proxy that isn't on the same host
# (Railway included), leaving this unset means every request looks like
# it came from your proxy, not the real visitor.
# Set this to your proxy's real, confirmed IP address(es) once you know
# them — e.g.:
#   FORWARDED_ALLOW_IPS=10.0.0.1
# Never set this to "*" (trust everyone) unless you have independently
# confirmed your app is reachable ONLY through that proxy — "*" trusts
# whatever X-Forwarded-For value the very first, unauthenticated hop
# supplies. This variable must be a real process environment variable
# (as Railway's own dashboard env vars are) — uvicorn reads it before
# this app's own .env loading runs, so setting it only here has no
# effect; export it in your actual shell if testing this locally.
# FORWARDED_ALLOW_IPS=

# Optional: directory for the rotating application log file (app.log).
# By default the app uses backend/logs/ automatically — see README.md
# ("Application logging").
# LOG_DIR=./logs

# --- WhatsApp integration (Stage 3 Step 6B) ---
# All four are optional — WhatsApp is opt-in per restaurant (see README.md,
# "WhatsApp integration"). Leave them unset until you're actually setting
# up WhatsApp; the webhook endpoints simply reject every request until
# they're configured, rather than the app refusing to start.

# Must match the "Verify token" you enter when configuring the webhook
# in the Meta App Dashboard.
# WHATSAPP_VERIFY_TOKEN=change_me_to_a_long_random_secret

# Your Meta app's App Secret (App Dashboard -> Settings -> Basic). Used
# to verify every webhook POST's X-Hub-Signature-256 header.
# WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Access token used to call the Meta Graph "send message" API. A
# temporary token from the App Dashboard works for local testing; a
# permanent token (System User) is needed for anything longer-lived.
# WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here

# Graph API version to call. Defaults to v21.0 if not set.
# WHATSAPP_API_VERSION=v21.0

# --- Widget CORS (Stage 4 Phase D) ---
# Optional. Each restaurant configures its own website origin(s) for its
# widget via the admin API (see README.md, "Widget allowed origins") —
# this variable is a SEPARATE, platform-level carve-out: a single origin
# always permitted against ANY restaurant's widget_key, regardless of
# that restaurant's own configured origins. Currently inert — nothing in
# this codebase yet makes a cross-origin call from it, since there is no
# admin-dashboard "preview my widget" feature yet. Leave unset until a
# future phase actually needs it.
# WIDGET_PREVIEW_ORIGIN=https://admin.yourdomain.com

# --- Booking confirmation email ---
# All optional and off by default — leave RESEND_API_KEY/EMAIL_FROM
# unset to run with confirmation emails fully disabled. A booking still
# succeeds normally either way; nothing about booking creation depends
# on this being configured. Set both to enable: after every successful
# booking (web chat or admin-created — not WhatsApp, see README), a
# confirmation email is sent to the customer via Resend's HTTPS API in a
# background task, so it can never delay the response or affect whether
# the booking itself commits. Get a key at https://resend.com/api-keys
# RESEND_API_KEY=re_your_real_resend_api_key

# Required (alongside RESEND_API_KEY) for confirmation emails to send —
# must be a sender address/domain verified in your Resend account.
# EMAIL_FROM=bookings@yourrestaurant.com

# --- Error tracking (Sentry) ---
# Optional and off by default — leave SENTRY_DSN unset to run with
# error tracking fully disabled (no import side effects, no network
# calls, nothing collected or sent anywhere). Set it to a real Sentry
# project DSN to enable it, in any environment (local, Docker,
# production). See app/monitoring.py for exactly what is and isn't
# sent — customer message content, names, phone numbers, emails,
# booking details, API keys/access tokens, and request bodies/headers
# are never included, regardless of this setting.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Free-text label shown in the Sentry UI to tell environments apart.
# Defaults to "production" if not set.
# SENTRY_ENVIRONMENT=production

# Fraction (0.0-1.0) of requests to sample for Sentry's separate
# performance-tracing feature. Defaults to 0.0 (off) — error capture
# always happens regardless of this value.
# SENTRY_TRACES_SAMPLE_RATE=0.0

# --- API docs (/docs, /redoc, /openapi.json) ---
# Optional. FastAPI's own default interactive documentation is ENABLED
# by default (this README recommends /docs for local testing, and even
# the Docker walkthrough says to try it) — unauthenticated, reachable by
# anyone who can reach this API at all. Set this to a real production
# environment (e.g. Railway) to turn it off there specifically, without
# affecting local dev or Docker.
# DISABLE_DOCS=true
