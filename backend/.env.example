# Copy this file to ".env" (same folder) and paste in your real API key.
# Never commit your real .env file to git or share it publicly.
# The application loads this file automatically — no manual terminal
# commands needed.

# Get a Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy_your_real_key_here

# Required: protects every /admin/* endpoint (restaurant, menu, opening
# hours). Requests must send this exact value in the "X-Admin-API-Key"
# header. Generate a long random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change_me_to_a_long_random_secret

# Optional: while rotating ADMIN_API_KEY, set this to the OLD key value
# and both the old and new keys are accepted. Remove this line once every
# admin client has switched to the new ADMIN_API_KEY to fully revoke the
# old one. See README.md ("Rotating the admin key") for the full steps.
# ADMIN_API_KEY_PREVIOUS=the_old_key_value_being_retired

# Optional: only needed if you want to point at a different database.
# By default the app uses backend/restaurant.db automatically.
# DATABASE_URL=sqlite:///./restaurant.db

# Optional: comma-separated list of browser origins allowed to call this
# API (CORS). If not set, defaults to common localhost dev origins plus
# "null" (the Origin a browser sends for a page opened directly as a
# local file, e.g. double-clicking frontend/index.html) — see README.
# Before deploying, set this to your real frontend domain(s) instead,
# e.g.:
#   ALLOWED_ORIGINS=https://www.example.com,https://example.com
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
